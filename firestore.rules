/**
 * @fileoverview Firestore Security Rules for FitJourney application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for all data. Each user has complete control over their profile, diet plans, and workout plans.
 *
 * Data Structure:
 * All user-related data is nested under /users/{userId}, where {userId} corresponds to the Firebase Authentication UID. Diet and workout plans are stored as subcollections within each user's document.
 *
 * Key Security Decisions:
 * - User data is private and only accessible to the authenticated user.
 * - Users can only create, read, update, and delete their own diet and workout plans.
 * - List operations are allowed only for the owner of the data.
 * - No global admin roles are defined, simplifying the access control.
 *
 * Denormalization for Authorization:
 * The data model enforces that `userId` in the `DietPlan` and `WorkoutPlan` documents must match the `userId` in the path `/users/{userId}`.
 * This allows for simple, path-based security rules without needing to read the document's contents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the root of the database, preventing any unauthorized access.
     * @path /
     * @allow (get, list, create, update, delete) - Denied for all requests as this is the root.
     * @deny (get, list, create, update, delete) - All requests.
     * @principle Prevents any unauthorized access to the root of the database.
     */
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * @description Manages user profile data, ensuring only the authenticated user can access their own profile.
     * @path /users/{userId}
     * @allow (create) - Allows a user to create their profile if the userId matches their auth UID.
     * @allow (get, update, delete) - Allows a user to get, update, and delete their profile if the userId matches their auth UID.
     * @deny (create) - Denies profile creation if the userId does not match the auth UID.
     * @deny (get, update, delete) - Denies access if the userId does not match the auth UID.
     * @principle Enforces document ownership, ensuring users can only manage their own profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isSelfCreation(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages diet plans for a specific user, ensuring only the owner can access them.
     * @path /users/{userId}/dietPlans/{dietPlanId}
     * @allow (create) - Allows a user to create a diet plan under their profile if the userId matches their auth UID and the dietPlanId matches the id property in the DietPlan object.
     * @allow (get, list, update, delete) - Allows a user to get, list, update, and delete their own diet plans if the userId matches their auth UID.
     * @deny (create) - Denies diet plan creation if the userId does not match the auth UID.
     * @deny (get, list, update, delete) - Denies access if the userId does not match the auth UID.
     * @principle Enforces document ownership for diet plans, ensuring users can only manage their own plans.
     */
    match /users/{userId}/dietPlans/{dietPlanId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.userId == userId && request.resource.data.id == dietPlanId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Manages workout plans for a specific user, ensuring only the owner can access them.
     * @path /users/{userId}/workoutPlans/{workoutPlanId}
     * @allow (create) - Allows a user to create a workout plan under their profile if the userId matches their auth UID and the workoutPlanId matches the id property in the WorkoutPlan object.
     * @allow (get, list, update, delete) - Allows a user to get, list, update, and delete their own workout plans if the userId matches their auth UID.
     * @deny (create) - Denies workout plan creation if the userId does not match the auth UID.
     * @deny (get, list, update, delete) - Denies access if the userId does not match the auth UID.
     * @principle Enforces document ownership for workout plans, ensuring users can only manage their own plans.
     */
    match /users/{userId}/workoutPlans/{workoutPlanId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.userId == userId && request.resource.data.id == workoutPlanId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    // --- Helper functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is creating their own user document.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is creating their own document, false otherwise.
     */
    function isSelfCreation(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing resource.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}