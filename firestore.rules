/**
 * @fileoverview Firestore Security Rules for FitJourney application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for all data. Each user has complete control over their profile, diet plans, workout plans, progress logs, body measurements, workout calendar entries, and gamification stats.
 *
 * Data Structure:
 * All user-related data is nested under /users/{userId}, where {userId} corresponds to the Firebase Authentication UID.
 *
 * Key Security Decisions:
 * - User data is private and only accessible to the authenticated user.
 * - Users can only create, read, update, and delete their own data.
 * - List operations are allowed only for the owner of the data.
 * - No global admin roles are defined, simplifying the access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the root of the database, preventing any unauthorized access.
     */
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * @description User profile — extended with all personalization fields.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isSelfCreation(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Daily progress logs (calories consumed/burned, workout completed).
     */
    match /users/{userId}/progressLogs/{logId} {
      allow get, list: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == logId;
    }

    /**
     * @description Body measurements history (weight, body parts, body fat %).
     */
    match /users/{userId}/bodyMeasurements/{measurementId} {
      allow get, list: if isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Workout calendar entries (planned / completed / skipped).
     */
    match /users/{userId}/workoutCalendar/{entryId} {
      allow get, list: if isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    // --- Helper functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfCreation(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}
