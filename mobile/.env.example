# Скопируйте в .env и заполните теми же значениями, что в корневом .env (EXPO_PUBLIC_FIREBASE_*)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL вашего Next.js сервера (для генерации планов ИИ)
# Локально на компьютере:
EXPO_PUBLIC_API_URL=http://localhost:9002
# Android-эмулятор:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:9002
# Телефон в той же Wi‑Fi сети (подставьте IP компьютера):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:9002
# Продакшен (Vercel и т.д.):
# EXPO_PUBLIC_API_URL=https://your-app.vercel.app
